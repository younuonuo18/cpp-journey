// PortScanner.cpp : TCP 端口扫描器（多线程版）
//
// 说明：原始版本由 GitHub Copilot 生成（单线程、每端口 300ms 超时），
// 在本机上扫 1~1024 端口需要 5 分钟以上，原因是本机对"连接被拒绝"的回环
// 连接有约 2 秒延迟。这里保持原逻辑不变，只做两处优化：
//   1) 用 64 个线程并行扫描（速度提升约 64 倍）
//   2) 单端口连接超时改为 200ms，并用非阻塞 connect + select 判断结果

#include <winsock2.h>
#include <ws2tcpip.h>
#include <process.h>
#include <stdio.h>
#include <string.h>

#pragma comment(lib, "ws2_32.lib")

#define THREAD_COUNT        64      // 并发扫描线程数
#define CONNECT_TIMEOUT_MS  200     // 单个端口的连接超时（毫秒）
#define START_PORT          1
#define END_PORT            1024

static volatile LONG g_nextPort = START_PORT;   // 下一个待扫描的端口号
static char          g_targetIp[64] = "127.0.0.1";
static CRITICAL_SECTION g_printLock;            // 保护屏幕输出，避免多线程打印交错
static LONG          g_openCount = 0;           // 已发现的开放端口数

// 扫描单个端口：返回 1 表示开放（TCP 连接成功），0 表示关闭或不可达
static int ScanPort(const char* ip, int port, int timeoutMs)
{
    SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (s == INVALID_SOCKET) {
        return 0;
    }

    // 设为非阻塞模式：connect 立即返回，用 select 等待连接结果
    u_long nonBlocking = 1;
    ioctlsocket(s, FIONBIO, &nonBlocking);

    sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons((u_short)port);
    InetPtonA(AF_INET, ip, &addr.sin_addr);

    int rc = connect(s, (sockaddr*)&addr, sizeof(addr));
    if (rc == SOCKET_ERROR) {
        int err = WSAGetLastError();
        if (err != WSAEWOULDBLOCK && err != WSAEINPROGRESS && err != WSAEALREADY) {
            // 立即失败（例如地址非法）-> 端口不可用
            closesocket(s);
            return 0;
        }

        // 等待套接字变为"可写"，即连接有结果
        fd_set writeSet;
        FD_ZERO(&writeSet);
        FD_SET(s, &writeSet);

        timeval tv;
        tv.tv_sec = timeoutMs / 1000;
        tv.tv_usec = (timeoutMs % 1000) * 1000;

        rc = select(0, NULL, &writeSet, NULL, &tv);
        if (rc <= 0) {
            // 0 = 超时（连接未完成）；< 0 = 出错。都视为端口未开放
            closesocket(s);
            return 0;
        }

        // 可写后还要检查套接字错误码，为 0 才算真正连上
        int sockErr = 0, len = sizeof(sockErr);
        if (getsockopt(s, SOL_SOCKET, SO_ERROR, (char*)&sockErr, &len) != 0 || sockErr != 0) {
            closesocket(s);
            return 0;
        }
    }

    closesocket(s);
    return 1;
}

// 工作线程：从公共计数器不断领取端口，直到超过 END_PORT
static unsigned __stdcall ScanWorker(void*)
{
    for (;;) {
        int port = (int)InterlockedIncrement(&g_nextPort) - 1;
        if (port > END_PORT) {
            break;
        }
        if (ScanPort(g_targetIp, port, CONNECT_TIMEOUT_MS)) {
            EnterCriticalSection(&g_printLock);
            printf("端口 %d: OPEN\n", port);
            fflush(stdout);
            LeaveCriticalSection(&g_printLock);
            InterlockedIncrement(&g_openCount);
        }
    }
    return 0;
}

int main(int argc, char* argv[])
{
    // 让控制台正确显示源码中的 UTF-8 中文
    SetConsoleOutputCP(CP_UTF8);

    // 命令行参数：目标 IP，未提供时默认扫描本机回环地址
    if (argc >= 2) {
        strncpy_s(g_targetIp, sizeof(g_targetIp), argv[1], _TRUNCATE);
    }

    WSADATA wsaData;
    if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0) {
        printf("WSAStartup 初始化失败。\n");
        return 1;
    }

    InitializeCriticalSection(&g_printLock);

    printf("扫描 %s 的端口 %d-%d (TCP) ...\n", g_targetIp, START_PORT, END_PORT);

    HANDLE threads[THREAD_COUNT];
    for (int i = 0; i < THREAD_COUNT; i++) {
        threads[i] = (HANDLE)_beginthreadex(NULL, 0, ScanWorker, NULL, 0, NULL);
    }
    for (int i = 0; i < THREAD_COUNT; i++) {
        if (threads[i] != NULL) {
            WaitForSingleObject(threads[i], INFINITE);
            CloseHandle(threads[i]);
        }
    }

    printf("扫描完成，共发现 %ld 个开放端口。\n", (long)g_openCount);

    DeleteCriticalSection(&g_printLock);
    WSACleanup();
    return 0;
}
